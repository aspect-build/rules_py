# An alwayslink (whole-archive) dep must fail at analysis: v1 cut.
cc_library(
    name = "cc_alwayslink_dep",
    testonly = True,
    srcs = ["cc_dep.c"],
    hdrs = ["cc_dep.h"],
    tags = ["manual"],
    alwayslink = True,
)

pep517_native_whl(
    name = "cc_deps_alwayslink_fixture",
    testonly = True,
    src = "//uv/private/pep517_whl:__stub_sdist",
    cc_deps = [":cc_alwayslink_dep"],
    tags = ["manual"],
    tool = "//uv/private/pep517_whl:__stub_tool",
    version = "0.0.1",
)

pep517_native_whl_cc_deps_failure_test(
