# Settings shared by every Bazel workspace in this repository; each workspace's
# .bazelrc imports this file. %workspace% here would expand to the importing
# workspace, so do not use it.

# Match Bazel 9's default. Without this, PySdistNativeBuild actions on
# Bazel 8 run without a default PATH, and clang's compiled-in default
# linker (`ld`, not bundled with the hermetic LLVM toolchain) can't be
# located. With it on, Bazel injects a static PATH=/bin:/usr/bin:/usr/local/bin
# so clang's PATH search hits the runner's /usr/bin/ld.
common --incompatible_strict_action_env

# Download every output on a remote cache hit. With minimal, an action cache
# entry whose blobs the remote cache has already dropped surfaces later as
# "lost inputs", and Bazel's whole-build retries repeat that until the job times
# out. Downloading eagerly turns a missing blob into a local re-execution.
common:ci --remote_download_outputs=all
common:ci --nobuild_runfile_links

# --jobs defaults to the core count, which caps remote cache lookups and downloads
# at 4 in flight on a GitHub-hosted runner. Local actions stay bounded by
# --local_resources.
common:ci --jobs=64

# Strip the configuration from output paths of actions that support path mapping.
build --experimental_output_paths=strip
