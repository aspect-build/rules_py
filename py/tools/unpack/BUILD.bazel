load("//py:defs.bzl", "py_test")
load("//py/private:py_source_tool.bzl", "py_source_tool")

# Shared test vectors are data, not a public Starlark library.
# gazelle:exclude exclude_glob_test_vectors.bzl

# The default wheel-unpack tool; the exec-tools toolchain runs `main` under
# its own interpreter (see py_runtime_toolchain).
py_source_tool(
    name = "unpack",
    srcs = ["exclude_glob.py"],
    main = "unpack.py",
    visibility = ["//visibility:public"],
)

exports_files(
    ["exclude_glob_test_vectors.bzl"],
    visibility = ["//py/tools/site_merge:__pkg__"],
)

py_test(
    name = "unpack_test",
    size = "small",
    srcs = ["unpack_test.py"],
    args = ["$(rootpath :unpack.py)"],
    data = [
        ":exclude_glob.py",
        ":exclude_glob_test_vectors.bzl",
        ":unpack.py",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
