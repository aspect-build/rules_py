load("//py:defs.bzl", "py_binary", "py_library", "py_test")

package(default_testonly = True)

py_library(
    name = "init",
    srcs = [
        "__init__.py",
    ],
)

py_library(
    name = "sub",
    srcs = [
        "sub.py",
    ],
    deps = [
        ":init",
    ],
)

py_library(
    name = "pi",
    srcs = [
        "pi.py",
    ],
)

py_binary(
    name = "main",
    srcs = [
        "__main__.py",
    ],
    deps = [
        ":pi",
        ":sub",
        "//py/tests/internal-deps/adder",
    ],
)

py_test(
    name = "assert",
    srcs = [
        "__main__.py",
    ],
    deps = [
        ":pi",
        ":sub",
        "//py/tests/internal-deps/adder",
    ],
)
