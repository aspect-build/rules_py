# A TreeArtifact in srcs is opaque to bytecode: it ships as source under sourceless.
copy_to_directory(
    name = "tree_sources",
    srcs = ["tree_module.py"],
    out = "tree_sources_tree",
    root_paths = ["py/tests/py-venv-multi-exec"],
)

py_venv(
    name = "tree_source_venv",
    srcs = [
        "entry_tree_source.py",
        ":tree_sources",
    ],
