load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load(":tools.bzl", "dummy_toolchain")

# Dummy toolchain backing target — no binary, used as a sentinel.
# Public so the generated @rules_py_tools repo can reference it for
# native_build toolchain entries.
dummy_toolchain(
    name = "empty",
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "native_build_toolchain_type",
    visibility = ["//visibility:public"],
)

# Resolved by exec platform to provide an interpreter for build actions
# (wheel unpacking, site-packages merging) under cross-compilation.
toolchain_type(
    name = "exec_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

# Resolved, in the configuration of a py_pex_binary(scie = ...)'s binary, to
# the python-build-standalone archive of that binary's interpreter. A separate
# type from the runtime's, so that only a scie build analyzes it and fetches
# the archive.
toolchain_type(
    name = "pbs_archive_toolchain_type",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "repo",
    srcs = ["repo.bzl"],
    visibility = ["//py:__subpackages__"],
    deps = [":tools"],
)

bzl_library(
    name = "tools",
    srcs = ["tools.bzl"],
    visibility = ["//py:__subpackages__"],
)

# gazelle:ignore
bzl_library(
    name = "types",
    srcs = ["types.bzl"],
    visibility = [
        "//py:__subpackages__",
        "//uv:__subpackages__",
    ],
)
