"""The platforms py_pex_binary builds scies for and on, and the tools it builds them with.

The one list of them: py/toolchains.bzl declares a science and a scie-jump repo
per platform from it, and a rules_py_scie_tools repo that selects between them,
so that MODULE.bazel imports only that one.
"""

# pex 2.104.1 requires science ~=0.21.0 and embeds scie-jump 1.13.0; science
# 0.21.1 is the first to fetch the build host's scie-jump from a mirror.
SCIENCE_VERSION = "0.21.1"
SCIE_JUMP_VERSION = "1.13.0"

# Keyed by pex's name for each platform (pex.sysconfig.SysPlatform), which is
# also the suffix science and scie-jump publish their binaries under. The
# scie-jump binaries are the static ones, which run on any Linux libc.
SCIE_PLATFORMS = {
    "linux-aarch64": struct(
        os = "linux",
        cpu = "aarch64",
        science_sha256 = "15d275395fd38357e36fd28be966bf536ad6797a43f36c0a4714847bcd81917f",
        scie_jump_sha256 = "08855450bc52b04f70f1e9b838b2f16e27655034989a44a74b6e062d6d8492c2",
    ),
    "linux-x86_64": struct(
        os = "linux",
        cpu = "x86_64",
        science_sha256 = "db9eca979bbafa67d5498ca2a5b969fffc74a09088f1fac072a060552fc19f6d",
        scie_jump_sha256 = "da6d8f18fef078452e4b4942039fcb068e3571cf24f4c40c6cc6ec8dd67eb7fb",
    ),
    "macos-aarch64": struct(
        os = "macos",
        cpu = "aarch64",
        science_sha256 = "17742d8c077339ac32479850e94d7195c2b5028415eecfbd8e076d761652c27b",
        scie_jump_sha256 = "a17ccad392ca4437f0c9040da9c8fc98552de4c452fc4f64b21f7d1f8099829b",
    ),
    "macos-x86_64": struct(
        os = "macos",
        cpu = "x86_64",
        science_sha256 = "f826be0d1f7e53f49d86cd33c90724ec00eaf6c8454b551826f761c43ff1b414",
        scie_jump_sha256 = "1226dbf8fc6c0e045b684b816eb407433c118e0555b1cde08c5df7492b1e88e7",
    ),
}

SCIE_TOOLS_REPOSITORY = "rules_py_scie_tools"

def scie_tool_repo_name(tool, platform):
    """The name of the repo holding one tool's binary for one platform.

    Args:
        tool: "science" or "scie_jump".
        platform: a key of SCIE_PLATFORMS.

    Returns:
        The repo name.
    """
    return "rules_py_{}_{}".format(tool, platform.replace("-", "_"))

def scie_platform_for_triple(triple):
    """pex's name for the platform of a python-build-standalone target triple.

    Args:
        triple: e.g. "x86_64-unknown-linux-gnu".

    Returns:
        The platform, e.g. "linux-x86_64" or "musl-linux-aarch64", or None if
        a scie cannot be built for it.
    """
    cpu, _, rest = triple.partition("-")
    prefix = ""
    if rest == "apple-darwin":
        platform = "macos-" + cpu
    elif rest == "unknown-linux-gnu":
        platform = "linux-" + cpu
    elif rest == "unknown-linux-musl":
        platform = "linux-" + cpu
        prefix = "musl-"
    else:
        return None
    if platform not in SCIE_PLATFORMS:
        return None
    return prefix + platform

def _scie_tools_repo_impl(rctx):
    content = [
        "# Generated by rules_py's scie_tools_repo.",
        'load("@bazel_skylib//lib:selects.bzl", "selects")',
        "",
        'package(default_visibility = ["//visibility:public"])',
    ]
    for platform, info in SCIE_PLATFORMS.items():
        content.append("""
config_setting(
    name = "{platform}",
    constraint_values = ["@platforms//os:{os}", "@platforms//cpu:{cpu}"],
)""".format(platform = platform, os = info.os, cpu = info.cpu))

    content.append("""
# The target platforms a scie can be built for. py_pex_binary(scie = ...) is
# incompatible with any other, so that a wildcard build skips it.
selects.config_setting_group(
    name = "supported",
    match_any = {platforms},
)""".format(platforms = repr([":" + platform for platform in SCIE_PLATFORMS])))

    # Selected by the platform of the configuration that names them: a scie
    # takes science and one scie-jump for the build host, and another scie-jump
    # for the target. Empty on other platforms. Only py_pex_binary(scie = ...)
    # depends on them, so that no other build fetches them.
    for tool in ["science", "scie_jump"]:
        arms = {
            ":" + platform: ["@{}//file".format(scie_tool_repo_name(tool, platform))]
            for platform in SCIE_PLATFORMS
        }
        arms["//conditions:default"] = []
        content.append("""
filegroup(
    name = "{tool}",
    srcs = select({arms}),
)""".format(tool = tool, arms = repr(arms)))

    rctx.file("BUILD.bazel", "\n".join(content) + "\n")
    return rctx.repo_metadata(reproducible = True)

scie_tools_repo = repository_rule(
    implementation = _scie_tools_repo_impl,
    doc = "Selects the science and scie-jump binaries for a configuration's platform.",
)
