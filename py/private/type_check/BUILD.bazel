load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//py:__subpackages__"])

# Set through the //py:type_check alias; see type_check.bzl. Off by default.
bool_flag(
    name = "type_check_flag",
    build_setting_default = False,
)

# Gates the default ty toolchain, so ty is only downloaded when type checking is on.
config_setting(
    name = "enabled",
    flag_values = {":type_check_flag": "true"},
    visibility = ["//visibility:public"],
)

# Set through the //py:type_check_config alias. Empty means the toolchain's
# own default configuration.
label_flag(
    name = "config",
    build_setting_default = ":no_config",
)

filegroup(name = "no_config")

exports_files([
    "empty.ty.toml",
    "empty_python/lib/python3.12/site-packages/README.md",
])

bzl_library(
    name = "foreign_import_dirs",
    srcs = ["foreign_import_dirs.bzl"],
    deps = [
        "//py/private:import_dirs_info",
        "//py/private:pth",
        "//py/private:py_info_interop",
    ],
)

bzl_library(
    name = "type_check",
    srcs = ["type_check.bzl"],
    deps = [
        "//py/private/toolchain:types",
        "@bazel_skylib//rules:common_settings",
    ],
)
