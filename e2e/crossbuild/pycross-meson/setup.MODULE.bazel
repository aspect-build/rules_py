"""meson-python cross-compilation case.

contourpy 1.3.3 is forced to build from its sdist (`[tool.uv]
no-binary-package`): a pybind11 C++ extension whose meson-python backend
needs the cross file `build_helper` generates (meson otherwise configures
as a native build and fails its compiler sanity checks), and whose C++
link exercises the -nostdlib++ toolchain's static runtime archives — a
plain link would leave std::__1/_Unwind_* unresolved until dlopen on the
target.

`default_build_dependencies` supplies the whole meson chain: meson-python
resolves meson and ninja from the build venv, and pybind11's headers come
from its wheel.
"""

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi_pycross_meson")
uv.project(
    default_build_dependencies = [
        "build",
        "meson",
        "meson-python",
        "ninja",
        "pybind11",
    ],
    hub_name = "pypi_pycross_meson",
    lock = "//pycross-meson:uv.lock",
    pyproject = "//pycross-meson:pyproject.toml",
)
use_repo(
    uv,
    "pypi_pycross_meson",
    "sdist_build__pycross_meson__contourpy__1_3_3",
)
