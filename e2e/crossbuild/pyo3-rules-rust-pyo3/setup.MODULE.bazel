"""pyo3-rules-rust-pyo3: the same PyO3 extension module as //pyo3-extension,
built with rules_rust_pyo3's `pyo3_extension` rule instead of a bare
rust_shared_library.

rules_rust_pyo3 ships its own pyo3 crates and a `pyo3_toolchain` that reads
the interpreter, its version and libpython from the rules_python toolchain
types rules_py's python_interpreters registers; the extension inherits the
Python identity from there, so this case covers that contract end to end.
"""

bazel_dep(name = "rules_rust_pyo3", version = "0.68.0")

register_toolchains(
    "@rules_rust_pyo3//toolchains:toolchain",
    "@rules_rust_pyo3//toolchains:rust_toolchain",
)
