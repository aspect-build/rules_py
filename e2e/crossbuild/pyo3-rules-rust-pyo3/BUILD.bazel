# A PyO3 extension module through rules_rust_pyo3: pyo3_extension builds the
# cdylib, names it after the target and provides PyInfo, so a py_test depends
# on it like any py_library.

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_image_layer", "py_test")
load("@rules_rust_pyo3//:defs.bzl", "pyo3_extension")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

pyo3_extension(
    name = "pyo3_ext_rr",
    srcs = ["src/lib.rs"],
    imports = ["."],
    # rules_rust_pyo3's stubgen reads the cdylib's introspection section and,
    # on ELF, gets the file header instead and panics; the extension itself
    # is unaffected, so leave the .pyi out.
    stubs = False,
    deps = ["//tools:llvm_unwinder"],
)

py_test(
    name = "test_pyo3_ext_rr",
    srcs = ["test_pyo3_ext_rr.py"],
    main = "test_pyo3_ext_rr.py",
    python_version = "3.12",
    deps = [":pyo3_ext_rr"],
)

# Packaged for OCI: pyo3_extension provides PyInfo rather than plain data, so
# py_image_layer's aspect takes a different path to the .so than in
# //pyo3-extension; the extracted layers must still run.
py_binary(
    name = "pyo3_app_rr",
    srcs = ["__main__.py"],
    main = "__main__.py",
    python_version = "3.12",
    deps = [":pyo3_ext_rr"],
)

py_image_layer(
    name = "pyo3_app_rr_layers",
    binary = ":pyo3_app_rr",
)

sh_test(
    name = "test_image_layers",
    srcs = ["test_image_layers.sh"],
    args = ["$(locations :pyo3_app_rr_layers)"],
    data = [":pyo3_app_rr_layers"],
)
