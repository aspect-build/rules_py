# Aspect's rc for vanilla `bazel`. Generated at the repository root by
# `aspect setup bazelrc`; regenerate there, not here. %workspace% is this
# workspace, so `../..` reaches the root it sits under — and re-expands to this
# workspace inside the imported file, which is why .aspect/generated/ is
# committed here too: --config=aspect-cloud writes the execution log there and
# Bazel will not create the directory.
try-import %workspace%/../../.aspect/bazelrc
import %workspace%/../../bazel/workspace.bazelrc

# Enable path mapping so WhlInstall actions are exercised with
# supports-path-mapping. Actions that declare the execution requirement get
# configuration-stripped cache keys; those that don't still work normally.
build --experimental_output_paths=strip
