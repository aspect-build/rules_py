        "snapshots/sdist_build__pycross_meson__contourpy__1_3_3.BUILD.bazel": "@sdist_build__pycross_meson__contourpy__1_3_3//:BUILD.bazel",
        "snapshots/sdist_build__pycross_msgpack__msgpack__1_2_1.BUILD.bazel": "@sdist_build__pycross_msgpack__msgpack__1_2_1//:BUILD.bazel",
        "snapshots/sdist_build__pycross_numpy__numpy__2_5_1.BUILD.bazel": "@sdist_build__pycross_numpy__numpy__2_5_1//:BUILD.bazel",
