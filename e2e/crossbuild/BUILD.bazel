# Only //tools needs a workspace-level linux platform (exec toolchain
# resolution test); each case declares its own flag-carrying platforms.
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")

package(default_visibility = ["//tools:__pkg__"])

platform(
    name = "arm64_linux",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    flags = [
        "--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc",
        "--@aspect_rules_py//uv/private/constraints/platform:platform_version=2.39",
        "--stripopt=--strip-all",
    ],
)

# The BUILD file sdist_build generates for every source build in this
# workspace, pinned so the wiring each sdist receives is a reviewable diff:
# which toolchains reach its action, whether a Rust sysroot layer, vendored
# crates or a cargo_lock target are emitted, and which build deps it gets.
# Toolchains must appear only where the sdist's backend needs them.
#
# To update after an intentional change: bazel run //:sdist_build_snapshots
write_source_files(
    name = "sdist_build_snapshots",
    files = {
        "snapshots/sdist_build__pycross_bcrypt__bcrypt__5_0_0.BUILD.bazel": "@sdist_build__pycross_bcrypt__bcrypt__5_0_0//:BUILD.bazel",
