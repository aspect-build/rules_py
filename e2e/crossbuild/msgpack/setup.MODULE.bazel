    default_build_dependencies = [
        "build",
        "setuptools",
    ],
    hub_name = "pypi_crossbuild_msgpack",
    lock = "//msgpack:uv.lock",
    pyproject = "//msgpack:pyproject.toml",
)
use_repo(uv, "pypi_crossbuild_msgpack")
