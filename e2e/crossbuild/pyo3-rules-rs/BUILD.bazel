# A PyO3 extension module through rules_rs's re-exported pyo3 rules.
#
# The vendored rules_rust needs a patch to build under Bazel 8 with path
# mapping on; see setup.MODULE.bazel and rules_rust_path_mapping_bazel8.patch.

load("@aspect_rules_py//py:defs.bzl", "py_test")
load("@rules_rust_rs//extensions/pyo3:defs.bzl", "pyo3_extension")

pyo3_extension(
    name = "pyo3_ext_rs",
    srcs = ["src/lib.rs"],
    imports = ["."],
)

py_test(
    name = "test_pyo3_ext_rs",
    srcs = ["test_pyo3_ext_rs.py"],
    main = "test_pyo3_ext_rs.py",
    python_version = "3.12",
    deps = [":pyo3_ext_rs"],
)
