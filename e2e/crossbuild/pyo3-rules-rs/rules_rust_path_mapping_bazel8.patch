Bazel 8: do not advertise path mapping for links through the cc_toolchain.

`--codegen=linker=` is built from `cc_common.get_tool_for_action` inside an
Args `map_each`, relying on the action's path mapper to rewrite the tool's
path. Bazel 8.x has no such mapper for cc_common: under
--experimental_output_paths=strip every other path in the rustc command is
mapped to bazel-out/cfg/... while the linker keeps its bazel-out/<cfg>/...
path, and rustc fails with "linker ... not found", first on the bootstrap of
process_wrapper. Actions that link through the cc_toolchain's linker stop
advertising `supports-path-mapping`; rlib compiles and links through the
Rust toolchain's own linker (a File) keep it.

--- a/rust/private/rustc.bzl
+++ b/rust/private/rustc.bzl
@@ -1451,6 +1451,9 @@
     # If linker_type is not explicitly set, infer from which linker is actually being used
     ld_is_direct_driver = False
 
+    # Whether the link goes through the cc_toolchain's linker (see supports_path_mapping below).
+    uses_cc_linker = False
+
     # gcc runs dlltool internally when acting as the linker, but rustc drives the linker directly so
     # it needs dlltool's path: apply outside the link-emit gate below since rlib compiles need it too.
     if cc_toolchain and toolchain.target_os == "windows" and toolchain.target_abi == "gnu":
@@ -1497,6 +1500,7 @@
                 rpaths,
                 add_flags_for_binary = add_flags_for_binary,
             )
+            uses_cc_linker = linker_config.rust_linker == None
 
             ld_is_direct_driver = linker_config.is_direct_driver
             link_env = _get_linker_env(linker_config)
@@ -1773,7 +1777,12 @@
         rustc_path = rustc_path,
         rustc_flags = rustc_flags,
         extra_rustc_flags = rust_flags_args,
-        supports_path_mapping = not target_has_location_expansion,
+        # `--codegen=linker=` carries the cc_toolchain's tool path as a plain
+        # string from `cc_common.get_tool_for_action`; Bazel 8 has no path
+        # mapper for cc_common, so under --experimental_output_paths=strip the
+        # linker would be the only unmapped path in the command and rustc
+        # fails with "linker ... not found". Keep those actions unmapped.
+        supports_path_mapping = not target_has_location_expansion and not uses_cc_linker,
         all = all_args,
     )
 
