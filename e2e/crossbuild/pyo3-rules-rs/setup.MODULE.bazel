"""pyo3-rules-rs: the same PyO3 extension module as //pyo3-extension, built
with the pyo3 extension rules_rs re-exports from its patched rules_rust
repository (exposed here as @rules_rust_rs) and the pyo3 toolchains rules_rs
provisions over its own crate resolution.

Like rules_rust_pyo3, that pyo3_toolchain reads the interpreter, its version
and libpython from the rules_python toolchain types python_interpreters
registers; this case covers the rules_rs flavour of that contract.
"""

register_toolchains(
    "@rules_rust_rs//extensions/pyo3/toolchains:toolchain",
    "@rules_rust_rs//extensions/pyo3/toolchains:rust_toolchain",
)
