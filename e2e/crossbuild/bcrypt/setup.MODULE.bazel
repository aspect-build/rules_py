"""bcrypt: setuptools-rust sdist build.

The Cargo cross env/toolchains wiring must stay identical across the four
rust suites (bcrypt, pydantic_core, rpds_py, tiktoken) — see
//tools:rust_host_sysroot for why CARGO/RUSTC alone aren't enough.
"""

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi_crossbuild_bcrypt")
uv.project(
    default_build_dependencies = [
        "build",
        "setuptools",
        "setuptools-rust",
        "wheel",
    ],
    hub_name = "pypi_crossbuild_bcrypt",
    lock = "//bcrypt:uv.lock",
    pyproject = "//bcrypt:pyproject.toml",
    rust_toolchain = "@rules_rust//rust/toolchain:current_rust_toolchain",
)
use_repo(uv, "pypi_crossbuild_bcrypt")
