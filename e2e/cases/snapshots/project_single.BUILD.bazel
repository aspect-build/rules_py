# Fallback for `:{package}_whl` aliases on workspace / editable packages
# (which have no underlying whl_install repo to point at).
filegroup(
    name = "empty_whl",
    srcs = [],
    visibility = ["//visibility:public"],
)



# cowsay
# {
#     "single_project_hub": {
#         "cowsay__6_1": {
#             "": 1,
#         },
#     },
# }


alias(
    name = "cowsay",
    actual = select({
        "//private/dep_group:single_project_hub": "//private/sccs:cowsay__6_1",
    }),
    visibility = ["//visibility:public"],
)


alias(
    name = "cowsay_whl",
    actual = select({
        "//private/dep_group:single_project_hub": "@whl_install__arch_alias_marker__cowsay__6_1//:whl",
    }),
    visibility = ["//visibility:public"],
)


# single_project_hub
# {
#     "single_project_hub": {
#         "single_project_hub__0_0_0": {
#             "": 1,
#         },
#     },
# }


alias(
    name = "single_project_hub",
    actual = select({
        "//private/dep_group:single_project_hub": "//private/sccs:single_project_hub__0_0_0",
    }),
    visibility = ["//visibility:public"],
)


alias(
    name = "single_project_hub_whl",
    actual = select({
        "//private/dep_group:single_project_hub": ":empty_whl",
    }),
    visibility = ["//visibility:public"],
)


filegroup(
    name = "gazelle_index_whls",
    srcs = [
        "@whl_install__arch_alias_marker__cowsay__6_1//:whl",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)
