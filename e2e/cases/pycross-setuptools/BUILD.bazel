    main = "test_setproctitle.py",
    python_version = _PY,
    deps = ["@pypi_pycross_setuptools//setproctitle"],
)

py_test(
    name = "test_zstandard",
    srcs = ["test_zstandard.py"],
    dep_group = _DEP_GROUP,
    main = "test_zstandard.py",
    python_version = _PY,
    deps = ["@pypi_pycross_setuptools//zstandard"],
)

py_test(
    name = "test_pyyaml",
    srcs = ["test_pyyaml.py"],
    dep_group = _DEP_GROUP,
    main = "test_pyyaml.py",
    python_version = _PY,
    deps = ["@pypi_pycross_setuptools//pyyaml"],
