load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":report_version.bzl", "report_exec_version", "report_version")

# Verify that $(PYTHON3) Make variable is provided by
# @python_interpreters//:current_py_toolchain.
genrule(
    name = "python_path",
    outs = ["python_path.txt"],
    cmd = "echo $(PYTHON3) > $@",
    toolchains = ["@python_interpreters//:current_py_toolchain"],
)

# Print the resolved runtime / exec-tools toolchain version; driven by test.sh
# under each version.
report_version(name = "report_version")

report_exec_version(name = "report_exec_version")

sh_test(
    name = "test",
    srcs = ["test_current_py_toolchain.sh"],
    data = [
        ":python_path",
        "@python_interpreters//:current_py_toolchain",
    ],
)
