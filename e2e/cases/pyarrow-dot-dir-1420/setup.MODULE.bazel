"""Regression #1420: pyarrow 14.0.1 Linux wheels ship a `pyarrow./` directory entry."""

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi_pyarrow_dot_dir")
uv.project(
    hub_name = "pypi_pyarrow_dot_dir",
    lock = "//pyarrow-dot-dir-1420:uv.lock",
    pyproject = "//pyarrow-dot-dir-1420:pyproject.toml",
)
use_repo(uv, "pypi_pyarrow_dot_dir")
