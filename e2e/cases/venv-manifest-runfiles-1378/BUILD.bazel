# Regression test for the manifest-based-runfiles import bug (rules_py #1378).
#
# A v2 py_binary exec'd as a subprocess whose only runfiles source is
# `RUNFILES_MANIFEST_FILE` never enters its venv: the manifest records the
# venv's `bin/python` as the *relative symlink target* of the real interpreter,
# so the launcher execs the interpreter directly and Python's venv detection
# (pyvenv.cfg relative to sys.executable) never fires. No site-packages, no
# `.pth` — every dep is unimportable. The issue reports the first-party half.
#
# #1273 fixed the tie when both sources are exported (the directory wins); the
# manifest-only path is what remains.
#
# gazelle:ignore

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_test", "py_unittest_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

py_library(
    name = "firstparty",
    srcs = [
        "firstparty/__init__.py",
        "firstparty/greet.py",
    ],
    imports = ["."],
)

py_binary(
    name = "check_manifest_imports",
    srcs = ["check_manifest_imports.py"],
    dep_group = "single_project_hub",
    python_version = "3.11",
    deps = [
        ":firstparty",
        "@pypi_single//cowsay",
    ],
)

# The unittest driver resolves its baked test files through runfiles too.
py_unittest_test(
    name = "manifest_unittest",
    srcs = ["manifest_unittest_test.py"],
    tags = ["manual"],
    deps = [":firstparty"],
)

sh_test(
    name = "test",
    srcs = ["wrapper.sh"],
    data = [
        ":check_manifest_imports",
        ":manifest_unittest",
    ],
    # The tree's MANIFEST symlink — the merged manifest this test hands to the
    # child — is only materialized in an unsandboxed runfiles tree.
    local = True,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Bytecode under manifest-only runfiles: pycache lists `__pycache__` beside the
# sources, and sourceless only the colocated .pyc, which the driver's lookup falls back to.
[
    py_unittest_test(
        name = "manifest_unittest_" + mode,
        srcs = ["manifest_unittest_test.py"],
        precompile = mode,
        tags = ["manual"],
        deps = [":firstparty"],
    )
    for mode in [
        "pycache",
        "sourceless",
    ]
]

[
    py_test(
        name = "manifest_{}_test".format(mode),
        srcs = ["manifest_bytecode_test.py"],
        data = [":manifest_unittest_" + mode],
        env = {"EXPECT_PYC": mode},
        # The tree's MANIFEST symlink is only materialized in an unsandboxed runfiles tree.
        local = True,
        main = "manifest_bytecode_test.py",
    )
    for mode in [
        "pycache",
        "sourceless",
    ]
]
