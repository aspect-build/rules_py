load("@aspect_rules_py//py:defs.bzl", "py_test")
load("//tools:pth_snapshot.bzl", "extract_venv_pth")

# backports.weakref and backports.shutil-get-terminal-size both ship a
# `backports/__init__.py` pkgutil namespace stub. The two files differ in
# bytes but not in effect, so the venv must merge the namespace instead of
# reporting a collision.
py_test(
    name = "test",
    srcs = ["__test__.py"],
    dep_group = "namespace-init-collision",
    expose_venv = True,
    main = "__test__.py",
    package_collisions = "error",
    python_version = "3.11",
    deps = [
        "@pypi_namespace_init_collision//backports_shutil_get_terminal_size",
        "@pypi_namespace_init_collision//backports_weakref",
    ],
)

# Snapshot fixture: both wheels are fully covered by the per-entry namespace
# merge (one stub projected, the rest per wheel), so the snapshot pins that
# NEITHER appears in the .pth fallback.
extract_venv_pth(
    name = "test_venv_pth_snapshot",
    out = "test.venv.pth",
    venv = ":test.venv",
)
