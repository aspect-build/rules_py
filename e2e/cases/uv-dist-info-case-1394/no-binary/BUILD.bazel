load("@aspect_rules_py//py:defs.bzl", "py_test")

# The lock is shared with //uv-dist-info-case-1394:lock_fixtures_test,
# which guards that it still pins the mismatched wheel.
exports_files(["uv.lock"])

# #1394 via the sdist route. `[tool.uv] no-binary-package` empties the wheel
# list, so the lock's `InquirerPy-0.3.4-py3-none-any.whl` is never fetched and
# its `.dist-info` never read; rules_py builds the package from its sdist
# instead.
py_test(
    name = "test_no_binary",
    srcs = ["test_no_binary.py"],
    dep_group = "uv-dist-info-1394-no-binary",
    main = "test_no_binary.py",
    python_version = "3.11",
    deps = [
        "@pypi_dist_info_1394_no_binary//inquirerpy",
    ],
)
