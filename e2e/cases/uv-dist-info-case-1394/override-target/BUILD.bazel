load("@aspect_rules_py//py:defs.bzl", "py_test")

# The lock is shared with //uv-dist-info-case-1394:lock_fixtures_test,
# which guards that it still pins the mismatched wheel.
exports_files(["uv.lock"])

# #1394 via the override route. `uv.override_package(target = ...)` replaces the
# locked package with `third_party/inquirerpy`, so the lock's
# `InquirerPy-0.3.4-py3-none-any.whl` is never fetched and its `.dist-info`
# never read. The stand-in carries a marker attribute the real wheel lacks.
py_test(
    name = "test_override",
    srcs = ["test_override.py"],
    dep_group = "uv-dist-info-1394-override",
    main = "test_override.py",
    python_version = "3.11",
    deps = [
        "@pypi_dist_info_1394_override//inquirerpy",
    ],
)
