import %workspace%/../../bazel/workspace.bazelrc

# Configure a default venv
# common --@pypi//dep_group=say

# Force a remote JDK runtime so cases/uv-sdist-jdk-build (the JNI sdist
# regression test) can analyze on hosts without a system JDK installed —
# rules_java's local_jdk emits a fail_rule when no host JDK is detected.
common --java_runtime_version=remotejdk_11

# These regression fixtures aren't written to type check (some deliberately
# ship packages split across wheels, compiled modules without stubs, etc.).
# type-check/test.sh turns checking on for its own case.
common --@aspect_rules_py//py:type_check=false
