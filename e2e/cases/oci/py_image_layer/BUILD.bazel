# Launcher-local `data` on py_venv_exec consumers sharing one venv. The
# launcher's `data` slot is independent of the venv's, so the source layer
# must collect it from the exec target itself: alpha ships a raw source
# file, beta an opaque DefaultInfo-only filegroup.
py_venv(
    name = "shared_exec_venv",
    srcs = ["server.py"],
)

filegroup(
    name = "exec_beta_payload",
    srcs = ["exec_beta_payload.json"],
)

py_venv_exec(
    name = "exec_data_alpha_bin",
    data = ["exec_alpha_payload.txt"],
    main = "server.py",
    venv = ":shared_exec_venv",
)

py_venv_exec(
    name = "exec_data_beta_bin",
    data = [":exec_beta_payload"],
    main = "server.py",
    venv = ":shared_exec_venv",
)

py_image_layer(
    name = "exec_data_layers",
    binaries = [
        ":exec_data_alpha_bin",
        ":exec_data_beta_bin",
    ],
)

py_test(
    name = "exec_data_layers_test",
    srcs = ["assert_tar_paths.py"],
    args = [
        "--tar-contains=_default.tar.gz=/exec_alpha_payload.txt",
        "--tar-contains=_default.tar.gz=/exec_beta_payload.json",
        "$(rootpaths :exec_data_layers)",
    ],
    data = [":exec_data_layers"],
    main = "assert_tar_paths.py",
)

