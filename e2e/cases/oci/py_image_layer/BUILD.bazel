            "zstd",
            "3",
        ],
    },
    groups = {
        "@pip//colorama": "third_party",
        "@pip//pyproject_hooks": "third_party",
    },
)

py_image_layer(
    name = "my_app_multi_layers",
    binary = ":my_app_multi_bin",
    layer_tier = ":my_app_multi_tier",
