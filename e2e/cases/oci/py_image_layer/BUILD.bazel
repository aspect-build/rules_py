        "--tar-absent=_default.tar.gz=/colorama/ansi.py",
        "--count=/colorama/ansi.py=1",
        "$(rootpaths :_resolved_wheel_layers)",
    ],
    data = [":_resolved_wheel_layers"],
    main = "assert_tar_paths.py",
)

