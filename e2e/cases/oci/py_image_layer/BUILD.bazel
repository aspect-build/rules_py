filegroup(
    name = "owned_group_payload",
    srcs = ["group_payloads/owned.txt"],
)

filegroup(
    name = "unowned_group_payload",
    srcs = ["group_payloads/unowned.txt"],
)

py_binary(
    name = "group_modes_bin",
    srcs = ["server.py"],
    data = [":owned_group_payload"],
)

py_image_layer(
    name = "group_modes_layers",
    binary = ":group_modes_bin",
    groups = {
        ":owned_group_payload": "owned",
        ":unowned_group_payload": "unowned",
    },
)

py_test(
    name = "group_modes_layers_test",
    srcs = ["assert_tar_paths.py"],
    args = [
        "--tar-mode=_owned.tar.gz=/owned.txt=0755",
        "--tar-mode=_unowned.tar.gz=/unowned.txt=0644",
