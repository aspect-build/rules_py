    # `platform_libc` flag; pin glibc here so cross-builds from a darwin host
    # select aspect_rules_py's interpreter instead of falling back to
    # rules_python's auto-registered toolchain.
    flags = [
        "--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc",
