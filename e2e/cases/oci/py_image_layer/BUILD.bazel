# Docker-free counterpart to the container_structure_test: run the same
# entrypoint (verify_all(imports=["colorama"])) on the host so the venv's
# site-packages symlinks must resolve to real files and colorama must import.
# Catches the regression where removing the `_wheels/<key>` indirection leaves
# the natural-rfpath symlinks dangling or a package unimportable — without a
# running daemon.
py_test(
    name = "my_app_host_test",
    srcs = ["__main__.py"],
    dep_group = "images",
    main = "__main__.py",
    deps = [
        "//oci/py_image_layer/branding",
        "//tools/verify_venv",
        "@aspect_rules_py//py/tests/internal-deps/adder",
        "@pypi_oci_py_image_layer//colorama",
    ],
)

