load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test", "py_venv_link")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:pth_snapshot.bzl", "extract_venv_bin")

py_test(
    name = "test",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    include_console_scripts = True,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

py_test(
    name = "venv_test",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    expose_venv = True,
    include_console_scripts = True,
    isolated = False,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

# Without `include_console_scripts`, the exposed `.venv` keeps `bin/activate`
# and the wrappers for `bazel run`, while the binary consuming it has neither.
py_binary(
    name = "exposed_bin",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    expose_venv = True,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

extract_venv_bin(
    name = "exposed_bin_bin_snapshot",
    out = "exposed_bin.bin.txt",
    target = ":exposed_bin",
)

extract_venv_bin(
    name = "exposed_bin_venv_bin_snapshot",
    out = "exposed_bin.venv.bin.txt",
    target = ":exposed_bin.venv",
)

# A link is a developer environment: it carries `activate` and the wrappers
# by default, and `include_console_scripts = False` links the interpreter alone.
py_venv_link(
    name = "exposed_bin.venv_link",
    venv = ":exposed_bin.venv",
)

py_venv_link(
    name = "exposed_bin.venv_link_no_scripts",
    include_console_scripts = False,
    venv = ":exposed_bin.venv",
)

extract_venv_bin(
    name = "exposed_bin_venv_link_bin_snapshot",
    out = "exposed_bin.venv_link.bin.txt",
    target = ":exposed_bin.venv_link",
)

extract_venv_bin(
    name = "exposed_bin_venv_link_no_scripts_bin_snapshot",
    out = "exposed_bin.venv_link_no_scripts.bin.txt",
    target = ":exposed_bin.venv_link_no_scripts",
)

# Links the tree the way `bazel run` would, sources `bin/activate` from it and
# runs a wrapper found through PATH.
sh_test(
    name = "venv_link_activate_test",
    srcs = ["venv_link_activate_test.sh"],
    data = [":exposed_bin.venv_link"],
)

# With `include_console_scripts`, the binary carries the wrappers and
# `activate` too.
py_binary(
    name = "opt_in_bin",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    expose_venv = True,
    include_console_scripts = True,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

extract_venv_bin(
    name = "opt_in_bin_bin_snapshot",
    out = "opt_in_bin.bin.txt",
    target = ":opt_in_bin",
)
