load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test")
load("//tools:pth_snapshot.bzl", "extract_venv_bin")

py_test(
    name = "test",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    include_console_scripts = True,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

py_test(
    name = "venv_test",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    expose_venv = True,
    include_console_scripts = True,
    isolated = False,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

# Without `include_console_scripts`, the exposed `.venv` keeps `bin/activate`
# and the wrappers for `bazel run`, while the binary consuming it has neither.
py_binary(
    name = "exposed_bin",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    expose_venv = True,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

extract_venv_bin(
    name = "exposed_bin_bin_snapshot",
    out = "exposed_bin.bin.txt",
    target = ":exposed_bin",
)

extract_venv_bin(
    name = "exposed_bin_venv_bin_snapshot",
    out = "exposed_bin.venv.bin.txt",
    target = ":exposed_bin.venv",
)

# With `include_console_scripts`, the binary carries the wrappers too, but
# never `activate`.
py_binary(
    name = "opt_in_bin",
    srcs = ["__test__.py"],
    dep_group = "venv-bin-scripts-423",
    expose_venv = True,
    include_console_scripts = True,
    main = "__test__.py",
    python_version = "3.11",
    deps = [
        "@pypi_venv_bin_scripts_423//dice",
        "@pypi_venv_bin_scripts_423//invoke",
    ],
)

extract_venv_bin(
    name = "opt_in_bin_bin_snapshot",
    out = "opt_in_bin.bin.txt",
    target = ":opt_in_bin",
)
