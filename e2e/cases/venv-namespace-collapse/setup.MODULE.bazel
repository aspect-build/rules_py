"""Namespace entries below a shared directory must collapse to per-wheel subtrees.

Two `nvidia` wheels ship an `__init__.py`-free tree, so every installed file is
its own PEP 420 namespace entry.
"""

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi_venv_namespace_collapse")
uv.project(
    hub_name = "pypi_venv_namespace_collapse",
    lock = "//venv-namespace-collapse:uv.lock",
    pyproject = "//venv-namespace-collapse:pyproject.toml",
)
use_repo(uv, "pypi_venv_namespace_collapse")
