package(default_testonly = True)

# test.sh keeps only checks needing a build-level error or an execution log.

py_venv(
    name = "shared_venv",
    srcs = [
        "entry_a.py",
        "shared_lib.py",
    ],
    imports = ["."],
)

py_venv_exec_test(
    name = "test_pyc_default",
    main = "entry_a.py",
    venv = ":shared_venv",
)

py_venv_exec_test(
    name = "test_pyc_cache",
    main = "entry_a.py",
    precompile = "pycache",
    venv = ":shared_venv",
)

py_venv_exec_test(
    name = "test_pyc_only",
    main = "entry_a.py",
    precompile = "sourceless",
    venv = ":shared_venv",
)

py_library(
    name = "overlap_a",
    srcs = [
        "entry_a.py",
        "shared_lib.py",
    ],
)

py_library(
    name = "overlap_b",
    srcs = [
        "entry_versioned.py",
        "shared_lib.py",
    ],
)

# Overlapping srcs share per-source compiles; the test asserts natural runfiles paths.
[
    py_test(
        name = "overlap_{}_test".format(mode),
        srcs = ["overlap_test.py"],
        env = {"EXPECT_PYC": mode},
        imports = ["."],
        main = "overlap_test.py",
        precompile = mode,
        deps = [
            ":overlap_a",
            ":overlap_b",
        ],
    )
    for mode in [
        "pycache",
        "sourceless",
    ]
]

# Images place each overlapping source's bytecode once, at its natural path,
# and never ship the per-target directories it was compiled into.
[
    [
        py_binary(
            name = "overlap_{}_bin".format(mode),
            srcs = ["overlap_test.py"],
            imports = ["."],
            main = "overlap_test.py",
            precompile = mode,
            deps = [
                ":overlap_a",
                ":overlap_b",
            ],
        ),
        py_image_layer(
            name = "overlap_{}_layers".format(mode),
            binary = ":overlap_{}_bin".format(mode),
        ),
        py_test(
            name = "overlap_{}_layers_test".format(mode),
            srcs = ["//oci/py_image_layer:assert_tar_paths.py"],
            args = checks + [
                "--count=.pyc/=0",
                "$(rootpaths :overlap_{}_layers)".format(mode),
            ],
            data = [":overlap_{}_layers".format(mode)],
            main = "//oci/py_image_layer:assert_tar_paths.py",
        ),
    ]
    for mode, checks in [
        (
            "pycache",
            [
                "--count=/_main/pyc/__pycache__/shared_lib.=1",
                "--count=/_main/pyc/shared_lib.py=1",
            ],
        ),
        (
            "sourceless",
            [
                "--count=/_main/pyc/shared_lib.pyc=1",
                "--absent=/_main/pyc/shared_lib.py",
            ],
        ),
    ]
]

# Two launchers in one image share overlapping bytecode: one file per path, never
# the per-target directories.
[
    [
        py_binary(
            name = "overlap_{}_peer_bin".format(mode),
            srcs = ["entry_a.py"],
            imports = ["."],
            main = "entry_a.py",
            precompile = mode,
            deps = [":overlap_b"],
        ),
        py_image_layer(
            name = "overlap_{}_multi_layers".format(mode),
            binaries = [
                ":overlap_{}_bin".format(mode),
                ":overlap_{}_peer_bin".format(mode),
            ],
        ),
        py_test(
            name = "overlap_{}_multi_layers_test".format(mode),
            srcs = ["//oci/py_image_layer:assert_tar_paths.py"],
            args = checks + [
                "--contains=/app/bin/overlap_{}_bin".format(mode),
                "--contains=/app/bin/overlap_{}_peer_bin".format(mode),
                "--count=.pyc/=0",
                "$(rootpaths :overlap_{}_multi_layers)".format(mode),
            ],
            data = [":overlap_{}_multi_layers".format(mode)],
            main = "//oci/py_image_layer:assert_tar_paths.py",
        ),
        oci_image(
            name = "overlap_{}_multi_image".format(mode),
            base = "@ubuntu",
            env = {
                "EXPECT_PYC": mode,
                "RUNFILES_DIR": "/app.runfiles",
            },
            tars = [":overlap_{}_multi_layers".format(mode)],
        ),
    ]
    for mode, checks in [
        (
            "pycache",
            [
                "--count=/_main/pyc/__pycache__/shared_lib.=1",
                "--count=/_main/pyc/shared_lib.py=1",
            ],
        ),
        (
            "sourceless",
            [
                "--count=/_main/pyc/shared_lib.pyc=1",
                "--absent=/_main/pyc/shared_lib.py",
            ],
        ),
    ]
]

[
    platform(
        name = "{}_linux".format(cpu),
        constraint_values = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        flags = [
            "--@aspect_rules_py//uv/private/constraints/platform:platform_libc=glibc",
        ],
    )
    for cpu in [
        "aarch64",
        "x86_64",
    ]
]

[
    [
        platform_transition_filegroup(
            name = "overlap_{}_multi_{}_image".format(mode, cpu),
            srcs = [":overlap_{}_multi_image".format(mode)],
            target_platform = ":{}_linux".format(cpu),
        ),
        container_structure_test(
            name = "overlap_{}_multi_{}_image_test".format(mode, cpu),
            configs = ["overlap_multi_image_test.yaml"],
            image = ":overlap_{}_multi_{}_image".format(mode, cpu),
            platform = docker_platform,
            tags = ["requires-docker"],
            target_compatible_with = ["@platforms//cpu:" + cpu],
        ),
    ]
    for mode in [
        "pycache",
        "sourceless",
    ]
    for cpu, docker_platform in [
        ("aarch64", "linux/aarch64"),
        ("x86_64", "linux/amd64"),
    ]
]

py_binary(
