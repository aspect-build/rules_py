# A library requested directly keeps the requesting configuration and still shares a launcher's bytecode.
[
    library_configuration_test(
        name = "library_{}_configuration_test".format(mode),
        expected = [
            "requesting",
            "shared",
        ],
        launcher = ":inner_bin",
        lib = ":pex_lib",
        precompile = mode,
    )
    for mode in [
        "pycache",
        "sourceless",
    ]
]

# A non-Python action below a launcher runs in the requesting configuration, so
# targets outside the Python closure share it; test.sh checks it across invocations.
genrule(
    name = "gen_shared_module",
    outs = ["shared_generated.py"],
    cmd = "echo 'VALUE = 1' > $@",
)

py_library(
    name = "gen_shared_lib",
    srcs = ["shared_generated.py"],
)

[
    py_binary(
        name = "gen_shared_{}_bin".format(precompile or "unset"),
        srcs = ["noop.py"],
        main = "noop.py",
        precompile = precompile,
        deps = [":gen_shared_lib"],
    )
    for precompile in [
        None,
        "pycache",
        "sourceless",
    ]
]

[
    dependency_configuration_test(
        name = "gen_shared_{}_under_{}_configuration_test".format(precompile, mode),
        dep = ":gen_shared_module",
        expected = "shared",
        launcher = ":gen_shared_{}_bin".format(precompile),
        precompile = mode,
    )
    for mode in [
        "pycache",
        "sourceless",
    ]
    for precompile in [
        "unset",
        "pycache",
        "sourceless",
    ]
]

# Source-only builds declare no bytecode, so another rule may own a natural
# bytecode path beside a library's source.
genrule(
    name = "genmod_bytecode",
    outs = ["genmod.pyc"],
    cmd = "touch $@",
)

py_library(
    name = "genmod_lib",
    srcs = ["genmod.py"],
    imports = ["."],
)

py_binary(
    name = "genmod_bin",
    srcs = ["genmod_main.py"],
    deps = [":genmod_lib"],
)

build_test(
    name = "source_mode_leaves_bytecode_paths_free_test",
    targets = [
        ":genmod_bin",
        ":genmod_bytecode",
    ],
)

# A non-isolated sourceless launcher refuses an ambient PYTHONOPTIMIZE at startup.
py_binary(
    name = "optimize_guard_bin",
    srcs = ["noop.py"],
    expose_venv = True,
    isolated = False,
    main = "noop.py",
    precompile = "sourceless",
)

# A module wrapper such as debugpy runs the main itself, so the guard cannot key on sys.argv.
py_binary(
    name = "optimize_guard_wrapped_bin",
    srcs = [
        "noop.py",
        "run_file.py",
    ],
    interpreter_options = [
        "-m",
        "pyc.run_file",
    ],
    isolated = False,
    main = "noop.py",
    precompile = "sourceless",
)

[
    sh_test(
        name = name,
        srcs = ["optimize_guard_test.sh"],
        args = ["$(rootpath {})".format(bin)],
        data = [bin],
    )
    for name, bin in [
        ("optimize_guard_test", ":optimize_guard_bin"),
        ("optimize_guard_wrapped_test", ":optimize_guard_wrapped_bin"),
    ]
]

# The guard line appears only in a venv that compiles bytecode; //:snapshots pins it.
extract_venv_pth(
    name = "optimize_guard_venv_pth",
    out = "optimize_guard.venv.pth",
    venv = ":optimize_guard_bin.venv",
