)

# Runtime data canonicalizes to source mode; an explicit attribute still pins the child.
py_binary(
    name = "data_child_bin",
    srcs = ["noop.py"],
    precompile = "sourceless",
    deps = [":pex_lib"],
)

py_test(
    name = "data_child_test",
