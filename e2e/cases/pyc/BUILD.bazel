    expose_venv_link = True,
)

py_pex_binary(
    name = "noop_pex",
    binary = ":noop_bin",
    python_interpreter_constraints = [],
)

py_library(
    name = "pex_lib",
    srcs = ["pex_lib.py"],
)

# The dependency's __pycache__ is in the binary's runfiles; the PEX drops it.
py_binary(
    name = "pyc_noop_bin",
    srcs = ["noop.py"],
    precompile = "pycache",
    deps = [":pex_lib"],
)

py_pex_binary(
    name = "pyc_noop_pex",
    binary = ":pyc_noop_bin",
    python_interpreter_constraints = [],
)

genrule(
    name = "data_fixture",
    outs = [
        "__pycache__/data_fixture.cpython-313.pyc",
        "data_fixture.pyc",
    ],
    cmd = "for f in $(OUTS); do echo fixture > $$f; done",
)

# A .pyc listed in data is payload, not compiled bytecode; the PEX ships it,
# including one in the standard `__pycache__` layout.
py_binary(
    name = "data_pyc_bin",
    srcs = ["noop.py"],
    data = [":data_fixture"],
)

py_pex_binary(
    name = "data_pyc_pex",
    binary = ":data_pyc_bin",
    python_interpreter_constraints = [],
)

py_test(
    name = "pex_no_bytecode_test",
    srcs = ["pex_no_bytecode_test.py"],
    data = [
        ":data_pyc_pex",
        ":noop_pex",
        ":pyc_noop_pex",
