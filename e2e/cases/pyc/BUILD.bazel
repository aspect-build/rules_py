# A launcher is not code, so deps reject it.
py_test(
    name = "_launcher_dep_test",
    srcs = ["noop.py"],
    main = "noop.py",
    tags = ["manual"],
    deps = [":inner_bin"],
)

analysis_failure_test(
    name = "launcher_dep_failure_test",
