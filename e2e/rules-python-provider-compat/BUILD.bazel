load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library", "py_pyc_compiler_toolchain", rules_py_test = "py_test")
load("@aspect_rules_py//py/tests:pyc_testing.bzl", "pyc_config_test")
load("@rules_python//python:py_library.bzl", rules_python_library = "py_library")
load("@rules_python//python:py_test.bzl", rules_python_test = "py_test")
load(":type_stubs_test.bzl", "merged_stubs_test")

# Only rules_python provides an interpreter here, so its runtime compiles bytecode.
py_pyc_compiler_toolchain(
    name = "rules_python_pyc_compiler",
    runtime = "@python_3_12//:py3_runtime",
)

toolchain(
    name = "rules_python_pyc_compiler_toolchain",
    toolchain = ":rules_python_pyc_compiler",
    toolchain_type = "@aspect_rules_py//py:pyc_compiler_toolchain_type",
)

# One converted library, two consumers: the @rules_python test stands in
# for a package the migration hasn't reached yet, the rules_py test for one it
# has. Under the compatibility layer the library carries both rulesets'
# providers, so neither consumer has to move before the other.

py_library(
    name = "lib",
    testonly = True,
    srcs = [
        "lib.py",
        "lib.pyi",
    ],
    imports = ["."],
)

# rules_python's PyInfo builder merges the emitted provider field by field, so
# the stub partition must arrive in the shape it expects: direct/transitive
# `pyi_files` populated, and no `.pyi` among `transitive_sources`.
rules_python_library(
    name = "rules_python_wrapper",
    testonly = True,
    deps = [":lib"],
)

merged_stubs_test(
    name = "merged_stubs_test",
    target_under_test = ":rules_python_wrapper",
)

# Disabled so the rules_py tests sharing consumer_test.py don't conflict on __pycache__.
rules_python_test(
    name = "rules_python_consumer_test",
    srcs = ["consumer_test.py"],
    main = "consumer_test.py",
    precompile = "disabled",
    deps = [":lib"],
)

rules_py_test(
    name = "rules_py_consumer_test",
    srcs = ["consumer_test.py"],
    main = "consumer_test.py",
    deps = [":lib"],
)

# A transitive edge: the @rules_python consumer sees sources and imports from a
# rules_py library it depends on only indirectly.
py_library(
    name = "leaf",
    testonly = True,
    srcs = ["leaf.py"],
    imports = ["."],
)

py_library(
    name = "middle",
    testonly = True,
    srcs = ["middle.py"],
    imports = ["."],
    deps = [":leaf"],
)

rules_python_test(
    name = "rules_python_transitive_consumer_test",
    srcs = ["transitive_consumer_test.py"],
    main = "transitive_consumer_test.py",
    deps = [":middle"],
)

# A converted binary as a dependency: the launcher rule (not just
# py_library) must carry rules_python's PyInfo, surfacing the sibling
# venv's imports and sources to an @rules_python consumer.
py_binary(
    name = "tool",
    testonly = True,
    srcs = ["tool.py"],
    imports = ["."],
    deps = [":lib"],
)

rules_python_test(
    name = "rules_python_binary_consumer_test",
    srcs = ["binary_consumer_test.py"],
    main = "binary_consumer_test.py",
    deps = [":tool"],
)

# py_library advertises rules_python's PyInfo here; the aspect must not add a second PycInfo.
[
    rules_py_test(
        name = "rules_py_consumer_{}_test".format(mode),
        srcs = ["consumer_test.py"],
        main = "consumer_test.py",
        precompile = mode,
        deps = [":lib"],
    )
    for mode in [
        "pycache",
        "sourceless",
    ]
]

[
    pyc_config_test(
        name = "{}_under_{}_test".format(consumer, mode),
        precompile = mode,
        target = ":{}_test".format(consumer),
    )
    for consumer in [
        "rules_python_consumer",
        "rules_python_transitive_consumer",
        "rules_python_binary_consumer",
    ]
    for mode in [
        "pycache",
        "sourceless",
    ]
]
